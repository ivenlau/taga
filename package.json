{
  "name": "taga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "evaluate:semantic": "node scripts/evaluate-semantic.mjs",
    "evaluate:semantic:strict": "node scripts/evaluate-semantic.mjs --suite=strict-300",
    "test": "vitest run",
    "test:ci": "vitest run --exclude tests/m1-benchmark.test.ts --testTimeout=15000",
    "test:benchmark": "vitest run tests/m1-benchmark.test.ts --maxWorkers=1 --testTimeout=15000",
    "web": "node dist/apps/web/src/main.js",
    "lint": "eslint . --max-warnings=0",
    "release:package": "node scripts/build-npm-package.mjs",
    "release:smoke": "node scripts/verify-npm-package.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "release:tag": "node scripts/tag-release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@zvec/zvec",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8",
    "@types/better-sqlite3": "^7.6.13"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@huggingface/transformers": "4.3.2",
    "@zvec/zvec": "0.8.0",
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "description": "Taga - local-first, auditable long-term memory framework for AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivenlau/taga.git"
  },
  "keywords": [
    "ai-agents",
    "memory",
    "long-term-memory",
    "mcp",
    "rag",
    "local-first"
  ]
}
